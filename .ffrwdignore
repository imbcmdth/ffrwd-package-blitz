# Build output, including whatever `cargo test` leaves behind. The module
# the lib SQL names is pulled back in by the manifest's closure; the rest of
# the directory stays out of the archive.
target/

# The Rust the module is built from, the test module and queries, and the
# scripts that write the test fonts and THIRD_PARTY_NOTICES: the archive is
# the built module, and the source is at the homepage.
core/
compose/
tests/
scripts/
Cargo.toml
Cargo.lock

# The README's stills are linked from the repository, not shipped.
examples/*.png

# Local development state, not package content.
ffrwd.lock
ffrwd.links
runs/
